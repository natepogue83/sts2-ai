+    {
+        if (_runState?.CurrentRoom is not TreasureRoom treasureRoom)
+            return Error("take_chest_relic requires a treasure room");
+        if (!_treasureChestOpened)
+            return Error("Treasure chest must be opened before taking its relic");
+        if (_treasureRelicTaken)
