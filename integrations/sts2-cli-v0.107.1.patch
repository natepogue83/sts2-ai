@@ -0,0 +1,56 @@
+"""Tests for staged, native-order treasure-room decisions."""
+
+
+def _enter_treasure(game, seed):
+    state = game.start(seed=seed)
+    state = game.skip_neow(state)
+    assert state["decision"] == "map_select"
+    return game.enter_room("treasure")
+
+
+def test_treasure_open_take_and_proceed(game):
+    state = _enter_treasure(game, "treasure_stages_1")
+    assert state["decision"] == "treasure"
+    assert state["treasure_stage"] == "unopened"
+    relics_before = len(state.get("player", {}).get("relics", []))
+
+    state = game.act("open_chest")
+    assert state["decision"] == "treasure"
+    assert state["treasure_stage"] == "relic_ready"
+    assert len(state["relics"]) == 1
+    assert state["treasure_proof"]["stage"] == "open_completed"
+    assert state["treasure_proof"]["postcondition_verified"] is True
+
+    state = game.act("take_chest_relic", relic_index=0)
+    assert state["decision"] == "treasure"
+    assert state["treasure_stage"] == "proceed"
+    assert state["treasure_proof"]["stage"] == "relic_awarded"
+    assert state["treasure_proof"]["inventory_delta"] == 1
+    assert state["treasure_proof"]["session_closed"] is True
+    assert len(state["player"]["relics"]) == relics_before + 1
+
+    state = game.act("leave_room")
+    assert state["decision"] == "map_select"
+
+
+def test_treasure_rejects_wrong_stage_and_resets_next_room(game):
+    state = _enter_treasure(game, "treasure_stages_2")
+
+    rejected = game.act("take_chest_relic", relic_index=0)
