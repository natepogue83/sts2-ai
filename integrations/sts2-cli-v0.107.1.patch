+            _lastTreasureProof = new Dictionary<string, object?>
+            {
+                ["stage"] = "open_failed",
+                ["offer_unchanged"] = offerUnchanged,
+                ["inventory_unchanged"] = inventoryUnchanged,
+                ["postcondition_verified"] = false,
+            };
+            return TreasureState(treasureRoom);
+        }
+
+        _lastTreasureProof = new Dictionary<string, object?>
+        {
+            ["stage"] = "open_completed",
+            ["offer_unchanged"] = true,
+            ["inventory_unchanged"] = true,
+            ["gold_before"] = goldBefore,
+            ["gold_after"] = player.Gold,
+            ["postcondition_verified"] = true,
+        };
+
+        if (current!.Count == 0)
+        {
+            relicSync.CompleteWithNoRelics();
+            _syncCtx.Pump();
+            WaitForActionExecutor();
