+        for (int i = 0; task != null && !task.IsCompleted && i < 200; i++)
+        {
+            _syncCtx.Pump();
+            Thread.Sleep(5);
+        }
+        if (task != null && !task.IsCompleted)
+        {
+            error = "Event option did not resume after reward completion";
+            return false;
+        }
+        try
+        {
+            task?.GetAwaiter().GetResult();
+            _pendingEventOptionTask = null;
+            _syncCtx.Pump();
+        }
+        catch (Exception ex)
+        {
+            _pendingEventOptionTask = null;
+            var localEvent = RunManager.Instance.EventSynchronizer?.GetLocalEvent();
+            if (allRewardsSelected && localEvent?.IsFinished == true
+                && ex.GetBaseException().Message.Contains(
