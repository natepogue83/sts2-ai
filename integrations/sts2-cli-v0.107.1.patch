+
+        var offered = relicSync.CurrentRelics[0];
+        var relicCountBefore = player.Relics.Count;
+        List<MegaCrit.Sts2.Core.Entities.TreasureRelicPicking.RelicPickingResult>? awarded = null;
+        Action<List<MegaCrit.Sts2.Core.Entities.TreasureRelicPicking.RelicPickingResult>> capture =
+            results => awarded = results;
+        relicSync.RelicsAwarded += capture;
