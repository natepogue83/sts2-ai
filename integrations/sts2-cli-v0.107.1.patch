+                ["session_closed"] = true,
+                ["postcondition_verified"] = false,
+            };
+            return TreasureState(treasureRoom);
+        }
+
+        _treasureRelicTaken = true;
+        _lastTreasureProof = new Dictionary<string, object?>
+        {
+            ["stage"] = "relic_awarded",
+            ["offered_id"] = offered.Id.ToString(),
+            ["result_player_verified"] = true,
+            ["session_closed"] = true,
+            ["inventory_delta"] = 1,
+            ["postcondition_verified"] = true,
+        };
+        return TreasureState(treasureRoom);
+    }
