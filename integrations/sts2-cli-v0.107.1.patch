+    private static Dictionary<string, int> SnapshotCounters<T>(
+        IEnumerable<KeyValuePair<T, int>> counters) where T : notnull
+    {
+        return counters
+            .OrderBy(pair => pair.Key.ToString(), StringComparer.Ordinal)
+            .ToDictionary(
+                pair => pair.Key.ToString() ?? "UNKNOWN",
+                pair => pair.Value,
+                StringComparer.Ordinal);
+    }
+
+    private static string SnapshotSeedHash(string seed)
+    {
+        return Convert.ToHexString(
+            SHA256.HashData(Encoding.UTF8.GetBytes(seed))).ToLowerInvariant();
+    }
+
+    private static Dictionary<string, object?> SnapshotCard(CardModel card)
+    {
+        return new Dictionary<string, object?>
+        {
+            ["id"] = card.Id.ToString(),
+            ["upgrade_level"] = card.CurrentUpgradeLevel,
+            ["energy_cost"] = card.EnergyCost?.GetResolved(),
+            ["base_replay_count"] = card.BaseReplayCount,
+            ["current_star_cost"] = card.CurrentStarCost,
+            ["last_stars_spent"] = card.LastStarsSpent,
+            ["exhaust_on_next_play"] = card.ExhaustOnNextPlay,
+            ["retain_this_turn"] = card.ShouldRetainThisTurn,
+            ["sly_this_turn"] = card.IsSlyThisTurn,
+            ["enchantment_id"] = card.Enchantment?.Id.ToString(),
+            ["enchantment_amount"] = card.Enchantment?.Amount,
+            ["affliction_id"] = card.Affliction?.Id.ToString(),
+            ["affliction_amount"] = card.Affliction?.Amount,
+            ["dynamic_vars"] = card.DynamicVars.Values
+                .OrderBy(value => value.Name, StringComparer.Ordinal)
+                .Select(value => new Dictionary<string, object?>
+                {
+                    ["name"] = value.Name,
+                    ["base_value"] = value.BaseValue,
+                }).ToList(),
+            ["keywords"] = card.Keywords?
+                .Where(keyword => keyword != CardKeyword.None)
+                .Select(keyword => keyword.ToString())
+                .OrderBy(value => value, StringComparer.Ordinal)
+                .ToList(),
+        };
+    }
