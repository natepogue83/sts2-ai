+    private bool TryFinishPendingEventRewardSelection(out string error)
+    {
+        var task = _pendingEventRewardSelectionTask;
+        var reward = _pendingEventRewardSelection;
+        if (task == null || reward == null)
+        {
+            error = string.Empty;
+            return true;
+        }
+        for (int i = 0; i < 200 && !task.IsCompleted; i++)
+        {
+            _syncCtx.Pump();
+            Thread.Sleep(5);
+        }
+        if (!task.IsCompleted)
+        {
+            error = "Event reward selection did not finish after subordinate selection";
+            return false;
+        }
+        try
+        {
+            var selected = task.GetAwaiter().GetResult();
+            _pendingEventRewardSelectionTask = null;
+            _pendingEventRewardSelection = null;
+            if (selected != reward.SuccessfullySelected)
+            {
+                error = "Event reward selection result disagrees with native reward state";
+                return false;
+            }
+            if (_pendingEventRewardsSet?.AllRewardsSuccessfullySelected == true)
+                return TryReleaseEventRewardSelector(out error);
+        }
+        catch (Exception ex)
+        {
+            _pendingEventRewardSelectionTask = null;
+            _pendingEventRewardSelection = null;
+            error = $"Event reward selection failed: {ex.GetBaseException().Message}";
+            return false;
+        }
+        error = string.Empty;
+        return true;
+    }
