new file mode 100644
index 0000000..37acdb1
--- /dev/null
+++ b/tests/test_snapshot.py
@@ -0,0 +1,67 @@
+"""Proof gates for process-isolated reconstructive snapshots."""
+
+
+def checkpoint(game):
+    result = game.send({"cmd": "snapshot_checkpoint"})
+    assert result["type"] == "snapshot_checkpoint"
+    assert result["schema_version"] == 1
+    return result
+
+
+def test_event_decision_fails_closed(game):
+    state = game.start(seed="snapshot_event_reject")
+    assert state["decision"] == "event_choice"
+
+    result = checkpoint(game)
+
+    assert result["snapshot_safe"] is False
+    assert result["stage"] == "unsupported"
+    assert "decision_stage_not_allowlisted" in result["reasons"]
+
+
+def test_stable_combat_checkpoint_covers_hidden_semantics(game):
+    seed = "snapshot_combat_safe"
+    game.start(seed=seed, ascension=10)
+    state = game.enter_room("combat", encounter="SHRINKER_BEETLE_WEAK")
+    assert state["decision"] == "combat_play"
+
+    first = checkpoint(game)
+    second = checkpoint(game)
+
+    assert first == second
+    assert first["snapshot_safe"] is True
+    assert first["stage"] == "combat_play"
+    assert first["reasons"] == []
+    assert first["quiescence"] == {
+        "sync_context_idle": True,
+        "sync_context_pending": 0,
+        "action_executor_running": False,
+        "current_action": None,
+        "action_queue_empty": True,
+    }
+    semantic = first["semantic"]
+    assert semantic["run_seed_sha256"] != seed
+    assert len(semantic["run_seed_sha256"]) == 64
+    assert set(semantic["run_rng_counters"]) >= {"Shuffle", "MonsterAi"}
+    assert semantic["player_rngs"][0]["counters"]
+    assert semantic["combat"]["piles"]
+    assert semantic["combat"]["creatures"]
+    assert semantic["next_action_id"] >= 0
+    assert semantic["excluded_nondeterministic_rng"] == (
+        "Rng.Chaotic (presentation only)"
+    )
+
+
+def test_pending_card_selection_is_rejected(game):
+    game.start(character="Defect", seed="snapshot_selection_reject")
+    game.set_player(potions=["ATTACK_POTION"])
+    state = game.enter_room("combat", encounter="SHRINKER_BEETLE_WEAK")
+    assert state["decision"] == "combat_play"
+
+    state = game.act("use_potion", potion_index=0)
+    assert state["decision"] == "card_select"
+
+    result = checkpoint(game)
+    assert result["snapshot_safe"] is False
+    assert "card_selector_pending" in result["reasons"]
+    assert "potion_selection_pending" in result["reasons"]
